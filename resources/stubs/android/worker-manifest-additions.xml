<!-- ═══ Service + Receiver (add inside <application>) ═══ -->

<!-- PHP Worker Foreground Service -->
<service
    android:name="com.nativephp.mobile.worker.PhpWorkerService"
    android:enabled="true"
    android:exported="false"
    android:foregroundServiceType="dataSync"
    android:stopWithTask="false">
    <intent-filter>
        <action android:name="com.nativephp.mobile.worker.START" />
        <action android:name="com.nativephp.mobile.worker.STOP" />
        <action android:name="com.nativephp.mobile.worker.STATUS" />
    </intent-filter>
</service>

<!-- Boot receiver to restart service after device reboot -->
<receiver
    android:name="com.nativephp.mobile.worker.WorkerBootReceiver"
    android:enabled="true"
    android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
    </intent-filter>
</receiver>
